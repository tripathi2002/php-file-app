# -----------------------------
# OS / Editor
# -----------------------------
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/

# -----------------------------
# Logs
# -----------------------------
*.log
logs/

# -----------------------------
# Environment / Config
# -----------------------------
.env
.env.local
.env.*.local

# -----------------------------
# Uploads & Chunks
# -----------------------------
uploads/*
!uploads/.gitkeep

chunks/*
!chunks/.gitkeep

# -----------------------------
# Runtime (rate limit, throttle, auth tokens)
# -----------------------------
rate_limit/*
!rate_limit/.gitkeep

throttle/*
!throttle/.gitkeep

tokens/*
!tokens/.gitkeep

# -----------------------------
# Cache / Temp
# -----------------------------
tmp/
temp/
cache/

# -----------------------------
# Composer (if added later)
# -----------------------------
vendor/
composer.lock

# -----------------------------
# Node (if frontend added later)
# -----------------------------
node_modules/
dist/
build/

# -----------------------------
# Debug / backup junk
# -----------------------------
debug.txt
* copy.*
* copy.js
*.bak
