# Isolate this app from the WordPress + LiteSpeed rules in the site root.
# Parent public_html/.htaccess must also skip /file-app/ — see docs/hosting-wordpress.md

<IfModule LiteSpeed>
CacheLookup off
</IfModule>

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /file-app/

# Block direct web access to runtime / secret folders
RewriteRule ^(chunks|tokens|throttle|rate_limit)(/|$) - [F,L]

# Serve real files and folders (api/v1/*.php, modules, ui/v1, …).
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Serve uploads only via download.php (auth + MIME). Block direct URL access.
RewriteRule ^uploads/ - [F,L]
</IfModule>

# -----------------------------
# Security: block sensitive files
# -----------------------------
<FilesMatch "\.(env|ini|log|sh|sql|bak|config)$">
    Require all denied
</FilesMatch>

<Files "config.php">
    Require all denied
</Files>

<Files "helpers.php">
    Require all denied
</Files>

<Files "auth.php">
    Require all denied
</Files>

<Files "rate-limit.php">
    Require all denied
</Files>

<Files "throttle.php">
    Require all denied
</Files>

# Access keys / cleanup may only run from the CLI
<Files "generate-key.php">
    Require all denied
</Files>

<Files "cleanup-chunks.php">
    Require all denied
</Files>

# Apache 2.2 fallback (some Hostinger stacks)
<IfModule !mod_authz_core.c>
    <FilesMatch "\.(env|ini|log|sh|sql|bak|config)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
    <FilesMatch "^(config|helpers|auth|rate-limit|throttle|generate-key)\.php$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>

# -----------------------------
# Upload limits (server-side)
# -----------------------------
<IfModule lsapi_module>
php_value upload_max_filesize 50M
php_value post_max_size 50M
php_value max_execution_time 300
php_value max_input_time 300
php_value memory_limit 256M
</IfModule>

# -----------------------------
# CORS is handled in config.php via an allowlist (CORS_ALLOWED_ORIGINS).
# -----------------------------
